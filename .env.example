# LWS PostgreSQL connection string; keep credentials server-side.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Private persistent directory outside public_html for application uploads.
PRIVATE_STORAGE_DIR=/home/USER/private/inptic-files

# Authentication: use the public HTTPS origin of the deployed site.
AUTH_SITE_URL=https://votre-domaine.tld

# LWS SMTP mail delivery (shared by account emails and the newsletter).
SMTP_HOST=mail.inptic-ga.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=inptic@inptic-ga.org
SMTP_PASSWORD=
SMTP_FROM_EMAIL=INPTIC <inptic@inptic-ga.org>

# Newsletter links.
# Set these URLs to your public site origin.
NEWSLETTER_SITE_URL=https://inptic-ga.org
NEWSLETTER_DIGEST_URL=https://inptic-ga.org/api/newsletter/weekly-digest
# Shared with the GitHub Actions weekly digest workflow; use a long random secret.
NEWSLETTER_CRON_SECRET=

# INPTIC assistant (server-side only; never use a NEXT_PUBLIC_ prefix).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Required to encrypt AI provider keys saved in the superadmin settings.
# Generate once with: openssl rand -hex 32
AI_SETTINGS_ENCRYPTION_KEY=
# Optional provider keys (can also be entered in /admin/ai-settings).
DASHSCOPE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional Ollama server URL; HTTP is allowed only for loopback addresses.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional social sign-in providers (server-side secrets only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
