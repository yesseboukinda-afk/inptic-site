{
  "name": "inptic-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:strapi": "npm --prefix strapi run develop",
    "build": "npm run build:next && npm run build:strapi",
    "build:next": "next typegen && npm run lint && next build --webpack",
    "build:strapi": "npm --prefix strapi install && npm --prefix strapi run build",
    "start": "next start",
    "start:strapi": "npm --prefix strapi run start",
    "start:all": "concurrently \"npm run start\" \"npm run start:strapi\"",
    "build:start": "npm run build && npm run start:all",
    "create-admin": "node scripts/create-admin.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.15",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "lottie-react": "^3.1.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.13",
    "three": "^0.186.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
